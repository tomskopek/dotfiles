#!/usr/bin/env bash
# bay — a hub for tmux sessions, one session per feature.
#
# Run `bay` with no arguments to open the hub. The hub lists every feature:
# live sessions first, then workspaces that exist on disk with no session,
# then any other tmux session. From the hub you switch, create, kill, or tear
# down a feature.
#
#   bay              open the hub (bind this to a key; see tmux.conf)
#                    keys: enter switch · C-t new · C-e rename · C-o note
#                          C-x kill · C-d done · C-n / C-p move · C-r reload
#   bay open <name>  create or complete the session, then switch to it
#   bay kill <name>  kill the session, keep the files
#   bay rename <old> <new>   rename a plain session (a workspace: see ws rename)
#   bay note <name> [text]   set a feature's note in one line, or open it in
#                            your editor; it heads the preview until the
#                            feature is torn down
#
# The hub is a switcher, so it behaves like one. The session you are in is
# pinned on top, marked ◉ and set apart by a rule, and the live sessions
# below it come in the order you last visited them. The cursor starts on the
# first of those, the session you most likely want; up twice reaches your own
# row, to rename, kill or tear it down without leaving. Nothing an agent does
# reorders a row: what it is doing shows in the mark, from `bay-hook`.
#
#   🔔 blocked on you   ✅ finished   ◐◓◑◒ working   ● idle   ○ no session
#
# The working mark spins. fzf has no timer, so `bay --tick` posts a frame to
# the port fzf opens with --listen; it stops the moment the hub closes, and
# skips the redraw entirely while no agent is working.
#
# Press prefix + b (see tmux.conf) to jump straight to whatever is blocked.
#
# Each session gets four windows, always at the same index:
#   0 claude   runs the agent          2 sh    plain shell for git, curl, ...
#   1 vim      runs the editor         3 srv   pre-split shells, nothing run
#
# Settings live in ~/.config/bay/config.sh — see bay.config.example.sh.
# Workspace paths come from ~/.config/ws/config.sh, shared with `ws`.
set -euo pipefail

# --- config ------------------------------------------------------------------
WS_CONFIG="${WS_CONFIG:-$HOME/.config/ws/config.sh}"
# shellcheck disable=SC1090
[ -f "$WS_CONFIG" ] && . "$WS_CONFIG"

WS_ROOT="${WS_ROOT:-$HOME/ws}"
DEV_ROOT="${DEV_ROOT:-$HOME/dev}"

BAY_CONFIG="${BAY_CONFIG:-$HOME/.config/bay/config.sh}"
# shellcheck disable=SC1090
[ -f "$BAY_CONFIG" ] && . "$BAY_CONFIG"

# Commands started in the claude and vim windows. Empty means "leave a shell".
BAY_CLAUDE_CMD="${BAY_CLAUDE_CMD:-claude}"
BAY_EDITOR_CMD="${BAY_EDITOR_CMD:-nvim}"
# Panes in the srv window. No commands run in them.
BAY_SRV_PANES="${BAY_SRV_PANES:-3}"
# Plain clones from DEV_ROOT to list in the hub, for work that needs no
# worktree at all, such as dotfiles. Space separated. Setting this is enough;
# BAY_INCLUDE_DEV_REPOS=1 instead lists every repo in DEV_ROOT.
BAY_DEV_REPOS="${BAY_DEV_REPOS:-}"
BAY_INCLUDE_DEV_REPOS="${BAY_INCLUDE_DEV_REPOS:-0}"

# Frames of the working spinner, separated by "|". Each one is padded to three
# display cells to match the other marks, so a one-cell glyph needs two
# trailing spaces and a two-cell emoji needs one. Seconds between frames, and
# the frame count after which a hub left open stops ticking.
BAY_SPIN_FRAMES="${BAY_SPIN_FRAMES:-◐  |◓  |◑  |◒  }"
BAY_SPIN_INTERVAL="${BAY_SPIN_INTERVAL:-0.2}"
BAY_SPIN_CAP="${BAY_SPIN_CAP:-900}"

# Preview cache. Nothing in the preview ever reaches the network: `bay
# --refresh` fills these in the background when the hub opens, and the preview
# only reads them. Seconds a PR lookup stays fresh.
BAY_CACHE_DIR="${BAY_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/bay}"
BAY_PR_TTL="${BAY_PR_TTL:-600}"

# Notes: one plain text file per feature, kept until it is torn down.
BAY_NOTES_DIR="${BAY_NOTES_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/bay/notes}"

die() { printf '\033[1;31m[bay]\033[0m %s\n' "$*" >&2; exit 1; }

printf -v TAB '\t'

# `ws` ships next to `bay`. Resolve it by path, because PATH inside a tmux
# popup or an fzf execute() is not the PATH of your interactive shell.
# Parameter expansion, not dirname/basename: the hub opens often and every
# process spawned here is ~5ms you wait for.
BAY_DIR=${0%/*}
[ "$BAY_DIR" = "$0" ] && BAY_DIR=.
BAY_DIR=$(cd "$BAY_DIR" && pwd)
BAY_SELF="$BAY_DIR/${0##*/}"
WS_BIN="$BAY_DIR/ws"
[ -x "$WS_BIN" ] || WS_BIN=$(command -v ws || true)

# --- helpers -----------------------------------------------------------------

has_session() { tmux has-session -t "=$1" 2>/dev/null; }

is_repo() { [ -e "$DEV_ROOT/$1/.git" ]; }

# The checked-out branch, read straight from .git. Sets REPLY. `git branch`
# costs ~25ms per repo; a worktree's .git is a one-line pointer to the real
# gitdir, and HEAD there is one line of text.
branch_of() {
  local gitdir=$1/.git line
  REPLY=""
  if [ -f "$gitdir" ]; then
    read -r line < "$gitdir" 2>/dev/null || return 0
    gitdir=${line#gitdir: }
  fi
  [ -r "$gitdir/HEAD" ] || return 0
  read -r line < "$gitdir/HEAD" 2>/dev/null || return 0
  case $line in
    'ref: refs/heads/'*) REPLY=${line#ref: refs/heads/} ;;
    *) REPLY=${line:0:7} ;;
  esac
}

# The git dir a repo shares with its worktrees, where Graphite keeps its
# files. A worktree's .git is one line: "gitdir: <common>/worktrees/<x>".
# Sets REPLY, empty when there is no git dir.
common_dir_of() {
  local g=$1/.git line
  REPLY=""
  if [ -d "$g" ]; then REPLY=$g; return 0; fi
  [ -f "$g" ] || return 0
  read -r line < "$g" 2>/dev/null || return 0
  line=${line#gitdir: }
  case $line in */worktrees/*) REPLY=${line%/worktrees/*} ;; *) REPLY=$line ;; esac
}

# Where a branch sits in its Graphite stack, as "k/n": k-th above the trunk
# in a stack n deep, n following the longest chain below it. Empty when
# Graphite does not track the branch or the stack is a single branch. gt 1.8
# keeps its metadata in a SQLite file in the common git dir; this is two
# recursive queries against it, read-only, so a gt running at the same time
# is left alone. Background use only: sqlite3 is a process. Sets REPLY.
stack_of() {
  local wt=$1 branch=$2 common db trunk=main cfg out up down b t
  REPLY=""
  command -v sqlite3 >/dev/null 2>&1 || return 0
  common_dir_of "$wt"; common=$REPLY
  REPLY=""
  db="$common/.graphite_metadata.db"
  [ -f "$db" ] || return 0
  if [ -f "$common/.graphite_repo_config" ]; then
    cfg=$(<"$common/.graphite_repo_config")
    case $cfg in
      *'"trunk"'*) trunk=${cfg#*\"trunk\"}; trunk=${trunk#*\"}; trunk=${trunk%%\"*} ;;
    esac
  fi
  # The trunk has children but is nobody's stack.
  [ "$branch" = "$trunk" ] && return 0
  b=${branch//\'/\'\'} t=${trunk//\'/\'\'}
  out=$(sqlite3 -readonly "$db" "
WITH RECURSIVE up(b, d) AS (
  SELECT branch_name, 1 FROM branch_metadata WHERE branch_name = '$b'
  UNION ALL
  SELECT m.parent_branch_name, up.d + 1 FROM branch_metadata m JOIN up ON m.branch_name = up.b
  WHERE m.parent_branch_name IS NOT NULL AND m.parent_branch_name != '' AND m.parent_branch_name != '$t' AND up.d < 50
) SELECT max(d) FROM up;
WITH RECURSIVE down(b, d) AS (
  SELECT '$b', 0
  UNION ALL
  SELECT m.branch_name, down.d + 1 FROM branch_metadata m JOIN down ON m.parent_branch_name = down.b WHERE down.d < 50
) SELECT max(d) FROM down;" 2>/dev/null) || return 0
  up=${out%%$'\n'*}; down=${out#*$'\n'}
  [ -n "$up" ] && [ "$down" != "$out" ] || return 0
  [ $((up + down)) -ge 2 ] || return 0
  REPLY="$up/$((up + down))"
}

# Plain clones offered in the hub: the allowlist if there is one, otherwise
# every repo in DEV_ROOT when BAY_INCLUDE_DEV_REPOS is on. Repos excluded in
# the ws config (duplicate clones and such) never show up.
dev_repos() {
  local name d
  REPLY=""
  if [ -n "$BAY_DEV_REPOS" ]; then
    for name in $BAY_DEV_REPOS; do
      is_repo "$name" && REPLY="$REPLY $name"
    done
    REPLY=${REPLY# }
    return 0
  fi
  [ "$BAY_INCLUDE_DEV_REPOS" = "1" ] || return 0
  for d in "$DEV_ROOT"/*/; do
    [ -e "$d.git" ] || continue
    d=${d%/}; name=${d##*/}
    case " ${WS_EXCLUDE_REPOS:-} " in *" $name "*) continue ;; esac
    REPLY="$REPLY $name"
  done
  REPLY=${REPLY# }
}

# Repo directories inside a workspace. Sets REPLY.
repos_of() {
  local d
  REPLY=""
  for d in "$WS_ROOT/$1"/*/; do
    [ -e "$d.git" ] || continue
    d=${d%/}
    REPLY="$REPLY ${d##*/}"
  done
  REPLY=${REPLY# }
}

# Where the windows should start. A one-repo workspace roots at that repo, so
# git and the editor work at once. A multi-repo workspace roots at the top.
root_for() {
  local name=$1 count
  if [ -d "$WS_ROOT/$name" ]; then
    repos_of "$name"
    # shellcheck disable=SC2086
    set -- $REPLY
    count=$#
    if [ "$count" = "1" ]; then
      echo "$WS_ROOT/$name/$1"
    else
      echo "$WS_ROOT/$name"
    fi
    return 0
  fi
  if [ -e "$DEV_ROOT/$name/.git" ]; then
    echo "$DEV_ROOT/$name"
    return 0
  fi
  return 1
}

# Seconds -> "3m", "2h", "4d". Sets REPLY, because the hub calls this once
# per row and $( ) would fork for each one.
human_idle() {
  local s=$1
  if [ "$s" -lt 60 ]; then REPLY="${s}s"
  elif [ "$s" -lt 3600 ]; then REPLY="$((s / 60))m"
  elif [ "$s" -lt 86400 ]; then REPLY="$((s / 3600))h"
  else REPLY="$((s / 86400))d"
  fi
}

# --- attention ---------------------------------------------------------------
# `bay-hook` records what each agent is doing in a tmux window option. Bells
# are no use here: Claude Code only rings one on some notification channels,
# and tmux drops the flag as soon as any client looks at the window.
# --- preview data ------------------------------------------------------------

# Flat cache files, keyed by a name safe for a filename. Sets REPLY.
cache_key() { REPLY=${1//[^a-zA-Z0-9._-]/_}; }

mtime_of() { stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null || echo 0; }

# -e, not -f: this is also used on the refresh lock, which is a directory, and
# testing -f made every concurrent refresh think the lock was stale and steal it.
cache_fresh() {
  [ -e "$1" ] || return 1
  [ $(( $(date +%s) - $(mtime_of "$1") )) -lt "$2" ]
}

# One cached line, or empty. Sets REPLY.
cache_read() {
  REPLY=""
  [ -f "$1" ] || return 0
  IFS= read -r REPLY < "$1" 2>/dev/null || REPLY=""
}

# Where main diverged. Sets REPLY, empty when there is no main to compare to.
merge_base_of() {
  local wt=$1 ref
  REPLY=""
  for ref in origin/main origin/master main master; do
    if REPLY=$(git -C "$wt" merge-base HEAD "$ref" 2>/dev/null) && [ -n "$REPLY" ]; then
      return 0
    fi
  done
  REPLY=""
}

# One frame of the working spinner, by index. Sets REPLY.
spin_mark() {
  local i=$1 n
  local IFS='|'
  # shellcheck disable=SC2086
  set -- $BAY_SPIN_FRAMES
  n=$#
  if [ "$n" -lt 1 ]; then REPLY='◐  '; return 0; fi
  i=$((i % n + 1))
  eval "REPLY=\${$i}"
}

# True when any agent is working, so the spinner has something to spin for.
any_busy() {
  case "$(tmux list-windows -a -F '#{@bay_state}' 2>/dev/null)" in
    *busy*) return 0 ;;
  esac
  # A tear-down under way counts too: its row should leave when it is done.
  local f
  for f in "$BAY_CACHE_DIR"/done/*.run; do
    [ -e "$f" ] && return 0
  done
  return 1
}

# The right-hand column of a hub row. Sets REPLY.
# $1 state, $2 seconds in that state, $3 the plain idle text to fall back on.
state_label() {
  local state=$1 age
  case "$state" in
    wait | done | busy) human_idle "$2"; age=$REPLY ;;
    *) REPLY=$3; return 0 ;;
  esac
  case "$state" in
    wait) REPLY="🔔 needs you $age" ;;
    done) REPLY="✅ done $age" ;;
    busy) REPLY="◐ working $age" ;;
  esac
}

window_index_exists() {
  tmux list-windows -t "=$1" -F '#{window_index}' 2>/dev/null | grep -qx "$2"
}

# Create the session with only the sh window, held at index 2. Both entry
# points share this, so ensure_layout always starts the programs itself.
create_session() {
  local name=$1 root=$2 first
  tmux new-session -d -s "$name" -c "$root" -n sh
  first=$(tmux list-windows -t "=$name" -F '#{window_index}' | head -1)
  [ "$first" = "2" ] || tmux move-window -d -s "=$name:$first" -t "=$name:2"
}

# Set by ensure_layout when it had to build the agent window, which means the
# session is new or was still half-built.
BAY_MADE_AGENT_WINDOW=0

# Add whichever role windows are missing, and start their programs.
ensure_layout() {
  local name=$1 root=$2 i
  # Reset, so the answer is about this call and not a previous one: cmd_hub
  # calls cmd_open in the same process.
  BAY_MADE_AGENT_WINDOW=0

  if ! window_index_exists "$name" 0; then
    tmux new-window -d -t "=$name:0" -n claude -c "$root"
    BAY_MADE_AGENT_WINDOW=1
    [ -n "$BAY_CLAUDE_CMD" ] && tmux send-keys -t "=$name:0" "$BAY_CLAUDE_CMD" C-m
  fi

  if ! window_index_exists "$name" 1; then
    tmux new-window -d -t "=$name:1" -n vim -c "$root"
    [ -n "$BAY_EDITOR_CMD" ] && tmux send-keys -t "=$name:1" "$BAY_EDITOR_CMD" C-m
  fi

  if ! window_index_exists "$name" 2; then
    tmux new-window -d -t "=$name:2" -n sh -c "$root"
  fi

  if ! window_index_exists "$name" 3; then
    tmux new-window -d -t "=$name:3" -n srv -c "$root"
    i=1
    while [ "$i" -lt "$BAY_SRV_PANES" ]; do
      tmux split-window -d -t "=$name:3" -c "$root"
      i=$((i + 1))
    done
    tmux select-layout -t "=$name:3" even-vertical >/dev/null
  fi
}

# The sh window is created before `ws new` adds the worktrees, so it can sit
# at the workspace root while the other windows sit in the repo. Move it.
resync_sh_window() {
  local name=$1 root=$2 cur
  cur=$(tmux display-message -p -t "=$name:2" '#{pane_current_path}' 2>/dev/null) || return 0
  [ "$cur" = "$root" ] && return 0
  # Leading space keeps this out of shell history.
  tmux send-keys -t "=$name:2" " cd '$root'" C-m
}

# The session you are in. A popup has no TMUX_PANE, so a tmux command run
# inside one that asks for "the current session" gets tmux's best guess:
# the attached session with the latest activity, which an agent printing
# output in another window changes under you. The key binding in tmux.conf
# therefore hands the popup its origin in BAY_HERE and BAY_CLIENT, expanded
# where the key was pressed. In a pane, TMUX_PANE pins it down instead.
# Sets REPLY, empty outside tmux.
here_session() {
  REPLY=""
  [ -n "${TMUX:-}" ] || return 0
  if [ -n "${BAY_HERE:-}" ]; then
    REPLY=$BAY_HERE
  elif [ -n "${TMUX_PANE:-}" ]; then
    REPLY=$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}' 2>/dev/null) || REPLY=""
  else
    REPLY=$(tmux display-message -p '#{session_name}' 2>/dev/null) || REPLY=""
  fi
}

# The client to move: the one named by the binding, else tmux's guess.
client_args() {
  REPLY=""
  [ -n "${BAY_CLIENT:-}" ] && REPLY="-c $BAY_CLIENT"
  return 0
}

focus() {
  local name=$1
  if [ -n "${TMUX:-}" ]; then
    client_args
    # shellcheck disable=SC2086
    tmux switch-client $REPLY -t "=$name"
  else
    tmux attach-session -t "=$name"
  fi
}

# --- commands ----------------------------------------------------------------

cmd_open() {
  local name=${1:-}
  [ -n "$name" ] || die "usage: bay open <name>"
  local root
  root=$(root_for "$name") || die "no workspace or repo named $name"

  if has_session "$name"; then
    ensure_layout "$name" "$root"
    # While cmd_new's build runs (@bay_building), the sh pane is busy with
    # `ws new` and cds on its own once that returns. Keys sent now would only
    # queue up for the shell that follows. `ws new` calls here last, so the
    # mark is cleared here too.
    if [ "$(tmux show-options -wv -t "=$name:2" @bay_building 2>/dev/null)" = on ]; then
      tmux set-option -wu -t "=$name:2" @bay_building 2>/dev/null || true
    else
      resync_sh_window "$name" "$root"
    fi
  else
    create_session "$name" "$root"
    ensure_layout "$name" "$root"
  fi

  # Land on the agent only when we just built it: a brand new session, or `ws
  # new` calling back here once its install finished in the sh window. Merely
  # switching to a session you already have keeps the window you left it on,
  # which tmux tracks per session -- selecting window 0 unconditionally is what
  # used to throw that away on every switch.
  if [ "$BAY_MADE_AGENT_WINDOW" = "1" ]; then
    tmux select-window -t "=$name:0" 2>/dev/null || true
  fi
  focus "$name"
}

# Killing the session a client is looking at detaches that client, popup and
# all (tmux's detach-on-destroy). Step over to the last session first, so
# killing or tearing down the one you are in lands you back where you were.
leave_if_current() {
  here_session
  [ -n "$REPLY" ] && [ "$REPLY" = "$1" ] || return 0
  client_args
  # shellcheck disable=SC2086
  tmux switch-client $REPLY -l 2>/dev/null || tmux switch-client $REPLY -n 2>/dev/null || true
}

cmd_kill() {
  local name=${1:-}
  [ -n "$name" ] || die "usage: bay kill <name>"
  has_session "$name" || return 0
  leave_if_current "$name"
  tmux kill-session -t "=$name"
}

# Rename a plain tmux session. A workspace is never renamed from here. Its
# name is its directory under $WS_ROOT, so renaming one means moving that
# directory out from under every shell, editor and agent in the session. The
# processes survive -- the inode does not change -- but anything keyed on the
# path does not follow: Claude Code files its sessions by project path, so
# the history of the old path is stranded and --resume in the new one finds
# nothing, and submodule gitdir pointers need repair. That is `ws rename`,
# typed on purpose in a shell, not a hub keystroke.
#
# Reasons a name cannot be renamed from here. die()s with the first one.
rename_source_check() {
  local old=$1
  [ -d "$WS_ROOT/$old" ] && die "$old is a workspace: renaming it moves $WS_ROOT/$old. If that is what you want, run  ws rename $old <new>  in a shell"
  is_repo "$old" && die "$old is a plain clone in $DEV_ROOT, not a session"
  has_session "$old" || die "no session named $old"
}

cmd_rename() {
  local old=${1:-} new=${2:-}
  [ -n "$old" ] && [ -n "$new" ] || die "usage: bay rename <old> <new>"
  [ "$old" = "$new" ] && return 0
  rename_source_check "$old"
  case "$new" in
    *[!a-zA-Z0-9._-]*) die "use letters, digits, dot, dash, underscore only" ;;
  esac
  has_session "$new" && die "session $new already exists"
  [ -e "$WS_ROOT/$new" ] && die "workspace $new already exists"
  is_repo "$new" && die "$new is already a repo in $DEV_ROOT"
  tmux rename-session -t "=$old" "$new"
  local a
  note_file "$old"; a=$REPLY
  note_file "$new"
  [ -f "$a" ] && mv -f "$a" "$REPLY"
  return 0
}

# Ask for the new name, from the hub. Refuse before asking, not after, and
# run the checks in a subshell so that a die() leaves us alive to hold the
# message on screen: fzf redraws the hub the moment execute() returns.
cmd_rename_prompt() {
  local old=${1:-} new
  [ -n "$old" ] || return 0
  if ( rename_source_check "$old" ); then
    printf 'rename %s to: ' "$old"
    read -r new || return 0
    [ -n "$new" ] || return 0
    ( cmd_rename "$old" "$new" ) && return 0
  fi
  printf '\npress enter to continue '
  read -r _ || true
}

# One row per feature: the name, a tab, then a pre-padded display string.
# fzf shows field 2 only and hands field 1 back to us, so the columns line up
# whatever the names are. Sets REPLY.
#
# $2 is pre-padded to three display cells by the caller, not by printf: printf
# counts bytes, and 🔔/✅ are two cells wide where ●/○ are one.
# $7 is the row's style: empty for a live session, "dim" for one with no
# session yet, "here" for the session you are in.
row() {
  local name=$1 mark=$2 word=$3 pr=$4 where=$5 age=$6 style=${7:-} disp=$1 pad
  [ ${#disp} -gt 18 ] && disp="${disp:0:17}…"
  [ ${#where} -gt 18 ] && where="${where:0:17}…"
  # Padded by hand: printf counts bytes, and the PR cell has glyphs in it.
  printf -v pad '%*s' $((15 - ${#pr})) ''
  case $style in
    dim)
      printf -v REPLY '%s\t\033[2m%s%-18s %-9s %s%s %-18s %4s\033[0m' \
        "$name" "$mark" "$disp" "$word" "$pr" "$pad" "$where" "$age" ;;
    here)
      # Bold magenta, the way the status bar names the session you are in. No
      # background: fzf paints its cursor line with one, and a second bar
      # read as a second cursor.
      [ -n "$pr" ] && pr=$'\033['"${PR_COL:-36}m$pr"$'\033[39m'
      printf -v REPLY '%s\t\033[1;35m%s%-18s\033[0m %-9s %s%s %-18s %4s' \
        "$name" "$mark" "$disp" "$word" "$pr" "$pad" "$where" "$age" ;;
    *)
      [ -n "$pr" ] && pr=$'\033['"${PR_COL:-36}m$pr"$'\033[39m'
      printf -v REPLY '%s\t%s%-18s %-9s %s%s %-18s %4s' \
        "$name" "$mark" "$disp" "$word" "$pr" "$pad" "$where" "$age" ;;
  esac
}

# The rule under the pinned row. Its name field is empty, so enter and the
# row keys fall through to nothing.
ROW_W=71
separator() {
  printf -v REPLY '%*s' "$ROW_W" ''
  REPLY=${REPLY// /─}
  REPLY=$'\t\033[2m'"$REPLY"$'\033[0m'
}

# The PR column for a feature: its open PR, how the checks stand, and where
# the branch sits in its Graphite stack, e.g. "#15327 ✓ ⧉2/4". Read from
# the cache files `bay --refresh` fills in the background, with builtins
# only: rows are rebuilt on every spinner frame. A workspace with several
# PRs shows the first and "+1". Sets REPLY, and PR_COL to an ANSI colour.
PR_COL=""
pr_cell() {
  local name=$1 wt branch f line num="" draft="" status="" fails="" stack="" more=0 cell=""
  REPLY="" PR_COL=""
  if [ -d "$WS_ROOT/$name" ]; then set -- "$WS_ROOT/$name"/*/; else set -- "$DEV_ROOT/$name/"; fi
  for wt in "$@"; do
    wt=${wt%/}
    [ -e "$wt/.git" ] || continue
    branch_of "$wt"; branch=$REPLY
    [ -n "$branch" ] || continue
    cache_key "${wt##*/}-$branch"
    f="$BAY_CACHE_DIR/pr/$REPLY"
    if [ -s "$f" ]; then
      if [ -n "$num" ]; then
        more=$((more + 1))
      else
        while IFS= read -r line; do
          case $line in
            "PR #"*)
              num=${line#PR #}; num=${num%% *}
              case $line in
                *"(draft)"*) draft=d ;;
                *"(merged)"*) status=merged ;;
                *"(closed)"*) status=closed ;;
              esac ;;
            "checks: "*failing*) status=fail; fails=${line#checks: }; fails=${fails%% *} ;;
            "checks: "*running*) [ -z "$status" ] && status=run ;;
            "checks: passing") [ -z "$status" ] && status=ok ;;
            "conflicts"*) [ "$status" != fail ] && status=conflict ;;
          esac
        done < "$f"
      fi
    fi
    if [ -z "$stack" ]; then
      f="$BAY_CACHE_DIR/git/$REPLY"
      [ -f "$f" ] && while IFS= read -r line; do
        case $line in "stack "*) stack=${line#stack } ;; esac
      done < "$f"
    fi
  done
  REPLY=""
  [ -n "$num" ] || [ -n "$stack" ] || return 0
  PR_COL=36
  if [ -n "$num" ]; then
    cell="#$num$draft"
    case $status in
      ok) cell="$cell ✓"; PR_COL=32 ;;
      fail) cell="$cell ✗$fails"; PR_COL=31 ;;
      run) cell="$cell ◌"; PR_COL=33 ;;
      conflict) cell="$cell !"; PR_COL=31 ;;
      merged) cell="$cell merged"; PR_COL=35 ;;
      closed) cell="$cell closed"; PR_COL=90 ;;
    esac
    [ "$more" -gt 0 ] && cell="$cell +$more"
  fi
  # The stack matters while the PR is live; once it is merged the word wins
  # the room.
  case $status in merged | closed) ;; *) [ -n "$stack" ] && cell="${cell:+$cell }⧉$stack" ;; esac
  [ ${#cell} -gt 15 ] && cell=${cell:0:15}
  REPLY=$cell
}

cmd_header() {
  printf 'enter switch · C-t new · C-e rename · C-o note · C-x kill · C-d done · C-r reload'
}

cmd_rows() {
  local frame=${1:-0}
  local now here="" dump live="" names="|"
  local tag a b c d name last act wins mark word where age state tmp r
  local wsess="" wrank=0 wstate="" wsince="" states=" " sessions="" list dir here_row="" out=""
  now=$(date +%s)
  here_session; here=$REPLY

  # One tmux round trip for the lot: the session you are in, every session,
  # and every window bay has flagged. A tmux command is a ~9ms round trip to
  # the server, so the count of them is what the hub's latency is made of.
  # #{S:...} loops over sessions and #{W:...} over that session's windows, so
  # each W line below belongs to the S line above it.
  dump=$(tmux display-message -p '#{S:
S|#{session_name}|#{session_last_attached}|#{session_activity}|#{session_windows}#{W:
W|#{@bay_state}|#{@bay_since}}}' 2>/dev/null) || dump=""

  # Roll the window states up per session as we read, then look them up by
  # name out of one string. Bash 3.2 has no associative arrays.
  while IFS='|' read -r tag a b c d; do
    case $tag in
      S)
        [ -n "$wsess" ] && states="$states$wsess=$wrank:$wstate:$wsince "
        wsess=$a; wrank=0; wstate=""; wsince=""
        names="$names$a|"
        sessions="$sessions$a|$b|$c|$d
"
        ;;
      W)
        case $a in wait) r=3 ;; done) r=2 ;; busy) r=1 ;; *) r=0 ;; esac
        if [ "$r" -gt "$wrank" ]; then wrank=$r; wstate=$a; wsince=$b; fi
        ;;
    esac
  done <<EOF
$dump
EOF
  [ -n "$wsess" ] && states="$states$wsess=$wrank:$wstate:$wsince "

  # Live sessions, in the order you last visited them -- so row one is where
  # you were before this one, and nothing an agent does moves a row. An agent
  # writing to its pane bumps session_activity constantly; ordering on that is
  # what made rows shuffle between openings.
  while IFS='|' read -r name last act wins; do
    [ -n "$name" ] || continue

    if [ -d "$WS_ROOT/$name" ]; then
      repos_of "$name"
      where="${REPLY:-no repos yet}"
    elif is_repo "$name"; then
      branch_of "$DEV_ROOT/$name"
      where=$REPLY
    else
      where="$wins windows"
    fi

    state=""
    case "$states" in
      *" $name="*)
        tmp=${states#*" $name="}; tmp=${tmp%% *}
        tmp=${tmp#*:}; state=${tmp%%:*}
        ;;
    esac
    case $state in
      wait) mark='🔔 '; word='needs you' ;;
      done) mark='✅ '; word='done' ;;
      # The spinner says "working" better than the word did, so the word
      # column stays empty and the row keeps one signal, not two.
      busy) spin_mark "$frame"; mark=$REPLY; word='' ;;
      *)    mark='●  '; word=''; [ "$name" = "$here" ] && mark='◉  ' ;;
    esac
    # A tear-down in flight, or one that failed, outranks what the agent did.
    teardown_state "$name"
    case $REPLY in
      running) spin_mark "$frame"; mark=$REPLY; word='removing' ;;
      failed) mark=$'\033[31m✗\033[39m  '; word='failed' ;;
    esac

    # Time since you were last in it, which is also what the list is sorted
    # on, so the column reads top to bottom as one increasing run.
    if [ "${last:-0}" -gt 0 ]; then
      human_idle "$((now - last))"; age=$REPLY
    else
      age='-'
    fi

    pr_cell "$name"
    if [ "$name" = "$here" ]; then
      row "$name" "$mark" "$word" "$REPLY" "$where" "now" here
      here_row=$REPLY
      continue
    fi
    row "$name" "$mark" "$word" "$REPLY" "$where" "$age"
    live="$live$last|$REPLY
"
  done <<EOF
$sessions
EOF
  # You, pinned on top and set apart, then everyone else by last visit.
  # Everything is gathered in $out and written once at the end: fzf reads a
  # reload as a stream and clamps the cursor to however many rows it has so
  # far, so two rows arriving ahead of the rest dragged it onto the rule.
  if [ -n "$here_row" ]; then
    separator
    out="$here_row
$REPLY
"
  fi
  [ -n "$live" ] && out="$out$(printf '%s' "$live" | sort -t'|' -k1,1nr | cut -d'|' -f2-)
"

  # Then what has no session yet: dimmed and always last, so the live block
  # above it is a fixed target for the eye.
  if [ -d "$WS_ROOT" ]; then
    for dir in "$WS_ROOT"/*/; do
      [ -d "$dir" ] || continue
      dir=${dir%/}; name=${dir##*/}
      case "$names" in *"|$name|"*) continue ;; esac
      repos_of "$name"; where=$REPLY
      teardown_state "$name"
      case $REPLY in
        running) spin_mark "$frame"; mark=$REPLY; word='removing' ;;
        failed) mark='✗  '; word='failed' ;;
        *) mark='○  '; word='' ;;
      esac
      pr_cell "$name"
      row "$name" "$mark" "$word" "$REPLY" "$where" '' dim
      out="$out$REPLY
"
    done
  fi

  dev_repos; list=$REPLY
  for name in $list; do
    case "$names" in *"|$name|"*) continue ;; esac
    [ -d "$WS_ROOT/$name" ] && continue
    branch_of "$DEV_ROOT/$name"; where=$REPLY
    pr_cell "$name"
    row "$name" '○  ' '' "$REPLY" "$where" '' dim
    out="$out$REPLY
"
  done
  printf '%s' "$out"
}

# --- background refresh ------------------------------------------------------

# The Claude Code transcript directory for a workspace, derived the way Claude
# Code derives it: the session's working directory with every / turned into -.
transcript_dir() {
  local root
  REPLY=""
  root=$(root_for "$1" 2>/dev/null) || return 0
  REPLY="$HOME/.claude/projects/${root//\//-}"
}

# The first thing you actually asked in this workspace. Sets REPLY.
#
# Oldest session, not newest: the newest one is whatever you happened to start
# in that directory last, which for lora-stacking was "download all the
# image/caption pairs" -- nothing to do with stacking LoRAs. The oldest is the
# ask the workspace was created for.
#
# Claude names a project directory after its working directory, and over a
# workspace's life that may have been the workspace root or any repo inside it,
# so look in all of them and take the earliest transcript that has a real ask.
first_ask() {
  local ws=$1 root d p
  local dirs=()
  REPLY=""
  command -v python3 >/dev/null 2>&1 || return 0
  root=$(root_for "$ws" 2>/dev/null) || root=""
  for d in "$WS_ROOT/$ws" "$root" "$WS_ROOT/$ws"/*/; do
    [ -n "$d" ] || continue
    d=${d%/}
    p="$HOME/.claude/projects/${d//\//-}"
    [ -d "$p" ] && dirs+=("$p")
  done
  [ ${#dirs[@]} -gt 0 ] || return 0
  REPLY=$(python3 -c '
import json, os, sys, glob

files = []
for d in sys.argv[1:]:
    for f in glob.glob(os.path.join(d, "*.jsonl")):
        try: files.append((os.path.getmtime(f), f))
        except OSError: pass
files.sort()

def first_ask(path):
    for line in open(path, errors="replace"):
        try: d = json.loads(line)
        except Exception: continue
        if d.get("type") != "user": continue
        c = d.get("message", {}).get("content")
        if isinstance(c, list):
            c = " ".join(x.get("text", "") for x in c
                         if isinstance(x, dict) and x.get("type") == "text")
        if not isinstance(c, str): continue
        c = c.strip()
        # Pasted-image markers and injected tags are not an ask.
        while c.startswith("[Image #"):
            c = c.split("]", 1)[-1].strip()
        if not c or c.startswith("<") or len(c) < 20: continue
        return " ".join(c.split())
    return ""

for _, f in files:
    a = first_ask(f)
    if a:
        print(a[:400]); break
' "${dirs[@]}" 2>/dev/null) || REPLY=""
}

# Every repo directory the hub can show a preview for: each workspace's repos,
# plus the plain clones the hub actually lists. Walking all of DEV_ROOT instead
# meant a `git status` against 34 repos to serve previews for two of them.
preview_dirs() {
  local dir wt name list
  for dir in "$WS_ROOT"/*/; do
    [ -d "$dir" ] || continue
    for wt in "$dir"*/; do
      [ -e "$wt.git" ] && printf '%s\n' "${wt%/}"
    done
  done
  dev_repos; list=$REPLY
  for name in $list; do
    [ -e "$DEV_ROOT/$name/.git" ] && printf '%s\n' "$DEV_ROOT/$name"
  done
}

# Dirty state and what has landed on the branch. `git status --porcelain` is
# ~185ms in the ui monorepo and merge-base plus log another ~85ms, so none of
# it belongs in a render either -- the preview reads the file this writes.
refresh_git() {
  local wt repo branch f base subjects n behind body
  while IFS= read -r wt; do
    [ -n "$wt" ] || continue
    repo=${wt##*/}
    branch_of "$wt"; branch=$REPLY
    [ -n "$branch" ] || continue
    cache_key "$repo-$branch"; f="$BAY_CACHE_DIR/git/$REPLY"
    cache_fresh "$f" 60 && continue

    body=""
    # The porcelain output is already in hand, so the file count is free -- and
    # "3 files" tells you whether there is real work in flight where a bare
    # *dirty did not.
    n=$(git --no-optional-locks -C "$wt" status --porcelain 2>/dev/null | grep -c .) || n=0
    [ "$n" -gt 0 ] && body="dirty $n
"
    merge_base_of "$wt"; base=$REPLY
    if [ -n "$base" ]; then
      # How far main has moved since we branched, i.e. how overdue a rebase is.
      behind=$(git -C "$wt" rev-list --count "$base"..origin/main 2>/dev/null) || behind=""
      [ -n "$behind" ] && [ "$behind" != "0" ] && body="${body}behind $behind
"
      subjects=$(git -C "$wt" log --format='%s' "$base"..HEAD 2>/dev/null)
      if [ -n "$subjects" ]; then
        n=$(printf '%s\n' "$subjects" | grep -c .)
        body="${body}ahead $n
$(printf '%s\n' "$subjects" | head -3)
"
      else
        body="${body}ahead 0
"
      fi
    fi
    stack_of "$wt" "$branch"
    [ -n "$REPLY" ] && body="${body}stack $REPLY
"
    printf '%s' "$body" > "$f"
  done < <(preview_dirs)
}

# owner/name from the remote URL. Parsed locally: `gh repo view` would be
# another ~500ms round trip per repo to learn something the URL already says.
repo_slug() {
  local url name rest owner
  REPLY=""
  url=$(git -C "$1" remote get-url origin 2>/dev/null) || return 0
  url=${url%.git}; url=${url%/}
  name=${url##*/}
  rest=${url%/*}
  owner=${rest##*[:/]}
  [ -n "$owner" ] && [ -n "$name" ] && REPLY="$owner/$name"
  return 0
}

# Unresolved review threads that still apply to the current code. This is the
# signal bugbot findings arrive on, and REST cannot see it. Sets REPLY.
review_threads() {
  local slug=$1 num=$2 out
  REPLY=""
  [ -n "$slug" ] && [ -n "$num" ] || return 0
  out=$(gh api graphql -f query='query($o:String!,$r:String!,$n:Int!){repository(owner:$o,name:$r){pullRequest(number:$n){
    reviewThreads(first:100){nodes{isResolved isOutdated}}}}}' \
    -F o="${slug%%/*}" -F r="${slug#*/}" -F n="$num" 2>/dev/null) || return 0
  REPLY=$(printf '%s' "$out" | python3 -c '
import json, sys
try:
    n = json.load(sys.stdin)["data"]["repository"]["pullRequest"]["reviewThreads"]["nodes"]
except Exception:
    raise SystemExit
live = sum(1 for x in n if not x["isResolved"] and not x["isOutdated"])
if live:
    print("%d unresolved review thread%s" % (live, "" if live == 1 else "s"))
' 2>/dev/null) || REPLY=""
}

# Open PRs, one gh call per branch. ~760ms each, which is exactly why this
# lives out here and not in the preview.
refresh_prs() {
  local wt repo branch f slug sel num state json extra
  command -v gh >/dev/null 2>&1 || return 0
  while IFS= read -r wt; do
    [ -n "$wt" ] || continue
    repo=${wt##*/}
    branch_of "$wt"; branch=$REPLY
    [ -n "$branch" ] || continue
    cache_key "$repo-$branch"; f="$BAY_CACHE_DIR/pr/$REPLY"
    cache_fresh "$f" "$BAY_PR_TTL" && continue

    # gh reads the repo from the worktree's remote, so just run it in there.
    # Every state, so a PR that merged is still news rather than a blank.
    json=$( (cd "$wt" && gh pr list --head "$branch" --state all --limit 5 \
              --json number,title,state,isDraft,mergeable,statusCheckRollup) 2>/dev/null ) || json=""
    # A lookup that failed (network, rate limit, gh itself) is not "no PR".
    # Keep what we knew; the stale file is retried on the next refresh. Only
    # an answer of [] means there is nothing to show.
    [ -n "$json" ] || continue
    if [ "$json" = "[]" ]; then
      : > "$f"
      continue
    fi

    # The PR that matters for the branch: an open one, else the newest merged,
    # else the newest closed. gh lists newest first.
    sel=$(printf '%s' "$json" | python3 -c '
import json, sys
d = json.load(sys.stdin)
for want in ("OPEN", "MERGED"):
    for p in d:
        if p.get("state") == want:
            print(p["number"], want); raise SystemExit
if d:
    print(d[0]["number"], d[0].get("state") or "CLOSED")' 2>/dev/null) || sel=""
    [ -n "$sel" ] || continue
    num=${sel%% *}; state=${sel#* }
    extra=""
    if [ "$state" = OPEN ]; then
      repo_slug "$wt"; slug=$REPLY
      review_threads "$slug" "$num"; extra=$REPLY
    fi

    # A rollup lists every attempt, so the same check appears once per re-run.
    # Keeping only the newest attempt per name is what separates a test that
    # broke from one whose run a later push cancelled -- on one PR here that
    # was the difference between 6 failures reported and 4 real ones.
    # Written beside the file and moved into place, so a parse that fails
    # leaves the old answer rather than a blank.
    if printf '%s' "$json" | python3 -c '
import json, sys

num = int(sys.argv[1])
d = json.load(sys.stdin)
p = next((x for x in d if x["number"] == num), None)
if p is None:
    raise SystemExit(1)
state = p.get("state") or ""
tag = ""
if state == "MERGED":
    tag = " (merged)"
elif state == "CLOSED":
    tag = " (closed)"
elif p.get("isDraft"):
    tag = " (draft)"
print("PR #%d%s  %s" % (p["number"], tag, p.get("title") or ""))
if state != "OPEN":
    raise SystemExit

latest = {}
for x in p.get("statusCheckRollup") or []:
    k = x.get("name") or x.get("context") or "?"
    if k not in latest or str(x.get("startedAt") or "") > str(latest[k].get("startedAt") or ""):
        latest[k] = x

def verdict(x):
    c = x.get("conclusion") or ""
    st = x.get("status") or x.get("state") or ""
    if st in ("IN_PROGRESS", "QUEUED", "PENDING") or (not c and st != "COMPLETED"):
        return "running"
    if c in ("SUCCESS", "NEUTRAL", "SKIPPED"):
        return "ok"
    if c in ("FAILURE", "ERROR", "TIMED_OUT", "ACTION_REQUIRED", "STARTUP_FAILURE"):
        return "fail"
    return "other"

fails = sorted(k for k, x in latest.items() if verdict(x) == "fail")
running = sum(1 for x in latest.values() if verdict(x) == "running")
if fails:
    line = "checks: %d failing" % len(fails)
    if running:
        line += ", %d running" % running
    print(line + "  " + ", ".join(fails[:3])[:70])
elif running:
    print("checks: %d running" % running)
elif latest:
    print("checks: passing")

if p.get("mergeable") == "CONFLICTING":
    print("conflicts with main")

extra = sys.argv[2] if len(sys.argv) > 2 else ""
if extra:
    print(extra)
' "$num" "$extra" > "$f.tmp" 2>/dev/null; then
      mv -f "$f.tmp" "$f"
    else
      rm -f "$f.tmp"
    fi
  done < <(preview_dirs)
}

refresh_ask() {
  local dir ws skey ask
  mkdir -p "$BAY_CACHE_DIR/ask"
  for dir in "$WS_ROOT"/*/; do
    [ -d "$dir" ] || continue
    ws=${dir%/}; ws=${ws##*/}
    cache_key "$ws"; skey=$REPLY
    # Reading it costs a python3 per workspace, so don't do that on every
    # single hub open.
    cache_fresh "$BAY_CACHE_DIR/ask/$skey.stamp" 300 && continue
    : > "$BAY_CACHE_DIR/ask/$skey.stamp"
    first_ask "$ws"; ask=$REPLY
    [ -n "$ask" ] && printf '%s\n' "${ask:0:150}" > "$BAY_CACHE_DIR/ask/$skey"
  done
}

# Global, not local: the EXIT trap below runs after cmd_refresh has returned,
# where a local would be out of scope and set -u would abort the cleanup.
BAY_LOCK=""
cmd_refresh() {
  local lock="$BAY_CACHE_DIR/refresh.lock"
  BAY_LOCK=$lock
  mkdir -p "$BAY_CACHE_DIR/pr" "$BAY_CACHE_DIR/git" "$BAY_CACHE_DIR/ask"
  # One refresh at a time. A lock older than ten minutes was left by something
  # that died, so take it.
  if ! mkdir "$lock" 2>/dev/null; then
    cache_fresh "$lock" 600 && return 0
    rmdir "$lock" 2>/dev/null || true
    mkdir "$lock" 2>/dev/null || return 0
  fi
  trap 'rmdir "$BAY_LOCK" 2>/dev/null || true' EXIT
  [ -d "$WS_ROOT" ] || return 0
  refresh_git
  refresh_prs
  refresh_ask
}

# Drive the working spinner. fzf has no timer event, so the frames come from
# out here: one POST per frame to the port fzf opened with --listen, each
# carrying the next frame number for `bay --rows`. Reload keeps the cursor and
# the query, and the preview is bound to `focus` rather than --preview, so a
# reload does not re-run it.
cmd_tick() {
  local port=${1:-} n=0 act
  [ -n "$port" ] || return 0
  command -v curl >/dev/null 2>&1 || return 0

  while [ "$n" -lt "$BAY_SPIN_CAP" ]; do
    # Nothing is working, so there is nothing to redraw. Still talk to fzf,
    # because a failed POST is how we learn the hub has closed.
    # reload-sync: the old rows stay up until the new ones are all in, so the
    # cursor never sees a half-loaded list.
    if any_busy; then act="reload-sync($BAY_SELF --rows $n)"; else act=ignore; fi
    curl -s -XPOST "http://localhost:$port" -d "$act" >/dev/null 2>&1 || return 0
    n=$((n + 1))
    sleep "$BAY_SPIN_INTERVAL"
  done
}

# One repo's block: branch, dirty, its open PR, and what has landed on the
# branch. The PR comes from cache; everything else is local git.
preview_repo() {
  local wt=$1 repo branch f line rest="" ahead="" dirty="" behind="" stack=""
  repo=${wt%/}; repo=${repo##*/}
  # Free: read out of .git, no fork.
  branch_of "${wt%/}"; branch=$REPLY

  cache_key "$repo-$branch"; f="$BAY_CACHE_DIR/git/$REPLY"
  if [ -f "$f" ]; then
    while IFS= read -r line; do
      case $line in
        "dirty "*) dirty=" \033[33m*${line#dirty } uncommitted\033[0m" ;;
        "behind "*) behind=${line#behind } ;;
        "ahead "*) ahead=${line#ahead } ;;
        "stack "*) stack=${line#stack } ;;
        *) rest="${rest}      ${line}
" ;;
      esac
    done < "$f"
  fi
  printf '  \033[1m%s\033[0m  %s%b\n' "$repo" "${branch:-?}" "$dirty"

  # The PR block is several lines: title, checks, conflicts, review threads.
  if [ -n "$branch" ]; then
    cache_key "$repo-$branch"; f="$BAY_CACHE_DIR/pr/$REPLY"
    if [ -s "$f" ]; then
      while IFS= read -r line; do
        [ -n "$line" ] || continue
        case $line in
          "checks: 0 failing"* | "checks: passing") printf '    \033[32m%s\033[0m\n' "$line" ;;
          "PR #"*"(merged)"*) printf '    \033[35m%s\033[0m\n' "$line" ;;
          "checks: "*failing* | "conflicts"* | *"unresolved review"*) printf '    \033[31m%s\033[0m\n' "$line" ;;
          *) printf '    \033[36m%s\033[0m\n' "$line" ;;
        esac
      done < "$f"
    fi
  fi

  [ -n "$stack" ] && printf '    \033[36m⧉ graphite stack %s\033[0m\n' "$stack"
  case $ahead in
    "") ;;
    0) printf '    nothing committed yet\n' ;;
    1) printf '    1 commit ahead of main\n' ;;
    *) printf '    %s commits ahead of main\n' "$ahead" ;;
  esac
  [ -n "$behind" ] && printf '    \033[33m%s behind main\033[0m\n' "$behind"
  [ -n "$rest" ] && printf '%s' "$rest"
  return 0
}

cmd_preview() {
  local name=${1:-} now wins label state since wt
  [ -n "$name" ] || return 0

  note_file "$name"
  if [ -s "$REPLY" ]; then
    printf '\033[1;33mnote\033[0m\n'
    head -20 "$REPLY" | sed 's/^/  /'
    printf '\n'
  fi

  # One call, and its failure is also the "no such session" answer.
  wins=$(tmux list-windows -t "=$name" -F \
    '  #{window_index} #{window_name}#{?window_active, (active),}|#{@bay_state}|#{@bay_since}' 2>/dev/null) || wins=""

  if [ -n "$wins" ]; then
    now=$(date +%s)
    printf '\033[1mwindows\033[0m\n'
    while IFS='|' read -r label state since; do
      if [ -n "$state" ]; then
        state_label "$state" "$((now - since))" ''
        printf '%-24s %s\n' "$label" "$REPLY"
      else
        printf '%s\n' "$label"
      fi
    done <<EOF
$wins
EOF
    printf '\n'
  fi

  local skey
  cache_key "$name"; skey=$REPLY
  cache_read "$BAY_CACHE_DIR/ask/$skey"
  [ -n "$REPLY" ] && printf '\033[1mfirst ask\033[0m\n  %s\n\n' "$REPLY"

  if [ -d "$WS_ROOT/$name" ]; then
    printf '\033[1mrepos\033[0m\n'
    for wt in "$WS_ROOT/$name"/*/; do
      [ -e "$wt.git" ] || continue
      preview_repo "$wt"
    done
  elif [ -e "$DEV_ROOT/$name/.git" ]; then
    printf '\033[1mrepo\033[0m\n'
    preview_repo "$DEV_ROOT/$name/"
  fi
}

# Ask for a name and repos, then open a session and run `ws new` inside it, so
# the install output is visible and the other windows are usable right away.
cmd_new() {
  local name repos
  printf 'feature name: '
  read -r name || return 2
  [ -n "$name" ] || return 2
  case "$name" in
    *[!a-zA-Z0-9._-]*) die "use letters, digits, dot, dash, underscore only" ;;
  esac
  [ -d "$WS_ROOT/$name" ] && die "workspace $name already exists"
  has_session "$name" && die "session $name already exists"

  [ -n "$WS_BIN" ] || die "cannot find the ws script"
  repos=$("$WS_BIN" repos | fzf --multi --prompt="repos for $name (tab to multi-select)> ") || return 2
  [ -n "$repos" ] || return 2

  mkdir -p "$WS_ROOT/$name"
  create_session "$name" "$WS_ROOT/$name"
  local shell_pane
  shell_pane=$(tmux display-message -p -t "=$name:2" '#{pane_id}')
  # Tells `bay open`, which `ws new` calls at the end, that this pane is
  # busy building and cds on its own.
  tmux set-option -w -t "$shell_pane" @bay_building on

  # Run `ws new` as the pane's own command, not as keys typed into the shell
  # tmux just started. Keys that reach a shell still reading its rc files are
  # echoed raw by the tty and again by the line editor, and any terminal
  # reply that arrives meanwhile joins the same input queue as garbage.
  # respawn-pane replaces that shell: ws runs at once and prints its log,
  # then the pane cds to the directory the session uses and becomes a login
  # shell, the way tmux would have started one. Nothing is ever typed.
  #
  # The commands run in a fresh environment. Pass non-default config paths
  # through; the shell that follows inherits none of it.
  local cfg="" shell cmd
  [ "$WS_CONFIG" != "$HOME/.config/ws/config.sh" ] && cfg="WS_CONFIG='$WS_CONFIG' "
  [ "$BAY_CONFIG" != "$HOME/.config/bay/config.sh" ] && cfg="${cfg}BAY_CONFIG='$BAY_CONFIG' "
  shell=$(tmux show-options -gv default-shell 2>/dev/null) || shell=""
  [ -n "$shell" ] || shell=${SHELL:-/bin/sh}
  # `ws new` calls `bay open` when it finishes, which adds the other windows.
  cmd="${cfg}'$WS_BIN' new '$name' $(echo "$repos" | tr '\n' ' ')"
  cmd="$cmd; r=\$(${cfg}'$BAY_SELF' --root '$name' 2>/dev/null) && cd \"\$r\"; exec '$shell' -l"
  tmux respawn-pane -k -t "$shell_pane" -c "$WS_ROOT/$name" "$cmd"
  focus "$name"
}

# The hub's C-t, run by fzf's execute() so it has the terminal. A build
# that went through leaves you looking at the new session, so the hub over
# it must go: execute() cannot end fzf, but fzf takes actions on the port it
# listens on, and an abort posted here runs the moment we return. A cancel
# goes straight back to the hub; an error holds its message on screen first.
cmd_new_prompt() {
  local rc=0
  ( cmd_new ) || rc=$?
  case "$rc" in
    0)
      if [ -n "${FZF_PORT:-}" ] && command -v curl >/dev/null 2>&1; then
        curl -s -XPOST "http://localhost:$FZF_PORT" -d abort >/dev/null 2>&1 || true
      fi ;;
    2) ;;
    *)
      printf '\npress enter to continue '
      read -r _ || true ;;
  esac
  return 0
}

# Tear-downs run detached. Removing worktrees and their node_modules can
# take a while, and the hub should not hold you for it. A <name>.run file in
# the cache says one is under way and collects its log; if the job fails the
# log becomes <name>.failed, the row says so, and C-d on it shows the log and
# offers another go. Both are read by cmd_rows with builtins only.
done_log() { REPLY="$BAY_CACHE_DIR/done/$1"; }

# A .run older than this is a job that died with its server, not one still
# working.
DONE_STALE=1800

# Sets REPLY: "" | running | failed
teardown_state() {
  local log
  done_log "$1"; log=$REPLY
  REPLY=""
  if [ -f "$log.run" ]; then
    if cache_fresh "$log.run" "$DONE_STALE"; then REPLY=running; return 0; fi
    mv -f "$log.run" "$log.failed" 2>/dev/null || true
  fi
  [ -f "$log.failed" ] && REPLY=failed
  return 0
}

pause() {
  printf '\npress enter to continue '
  read -r _ || true
}

# A line on every attached client, gone after three seconds.
toast() {
  local c
  for c in $(tmux list-clients -F '#{client_name}' 2>/dev/null); do
    tmux display-message -c "$c" -d 3000 "$1" 2>/dev/null || true
  done
}

cmd_done() {
  local name=${1:-} reply force="" log cfg=""
  [ -n "$name" ] || return 0
  [ -d "$WS_ROOT/$name" ] || die "$name is not a workspace"
  [ -n "$WS_BIN" ] || die "cannot find the ws script"
  mkdir -p "$BAY_CACHE_DIR/done"
  done_log "$name"; log=$REPLY

  teardown_state "$name"
  case $REPLY in
    running)
      printf 'tear down of %s is still running\n' "$name"
      pause
      return 0 ;;
    failed)
      printf 'the last tear down of %s failed:\n\n' "$name"
      cat "$log.failed"
      printf '\n' ;;
  esac

  # `ws done` refuses while a worktree has uncommitted changes. Ask that
  # here, where a question can still be put, and offer the way out ws
  # names, spelled out, because it throws the work away.
  if ! "$WS_BIN" done --check "$name"; then
    printf '\ndiscard those changes and remove %s anyway? [y/N] ' "$name"
    read -r reply || return 0
    case "$reply" in y | Y) force="--force" ;; *) return 0 ;; esac
  else
    printf 'tear down %s — remove worktrees and session? [y/N] ' "$name"
    read -r reply || return 0
    case "$reply" in y | Y) ;; *) return 0 ;; esac
  fi

  rm -f "$log.failed"
  : > "$log.run"
  leave_if_current "$name"
  # run-shell -b: the job lives in the tmux server, so neither closing the
  # hub nor the session going away under it ends the removal.
  [ "$WS_CONFIG" != "$HOME/.config/ws/config.sh" ] && cfg="WS_CONFIG='$WS_CONFIG' "
  [ "$BAY_CONFIG" != "$HOME/.config/bay/config.sh" ] && cfg="${cfg}BAY_CONFIG='$BAY_CONFIG' "
  tmux run-shell -b "${cfg}'$BAY_SELF' --done-job '$name' $force"
}

# The detached half of cmd_done.
cmd_done_job() {
  local name=${1:-} force=${2:-} log
  [ -n "$name" ] || return 0
  done_log "$name"; log=$REPLY
  # shellcheck disable=SC2086
  if "$WS_BIN" done "$name" $force > "$log.run" 2>&1; then
    rm -f "$log.run"
    note_file "$name"; rm -f "$REPLY"
    toast "#[fg=green]✓ $name#[default] torn down"
  else
    mv -f "$log.run" "$log.failed"
    toast "#[fg=red,bold]✗ $name#[default] tear down failed · C-d on its row shows why"
  fi
}

# The hub's C-d. A subshell, like cmd_rename_prompt, so a die() in the checks
# above holds its message on screen instead of ending us under fzf.
cmd_done_prompt() {
  if ! ( cmd_done "$@" ); then
    pause
  fi
}

# One note per feature, a plain text file named after it. It is the first
# thing the preview shows, and it goes when the feature is torn down.
note_file() {
  cache_key "$1"
  REPLY="$BAY_NOTES_DIR/$REPLY.md"
}

# bay note <name> [text]: with text, that is the note; without, the note
# opens in your editor. An emptied note is no note.
cmd_note() {
  local name=${1:-} f ed
  [ -n "$name" ] || die "usage: bay note <name> [text]"
  shift
  note_file "$name"; f=$REPLY
  mkdir -p "$BAY_NOTES_DIR"
  if [ $# -gt 0 ]; then
    printf '%s\n' "$*" > "$f"
    return 0
  fi
  ed=${VISUAL:-${EDITOR:-${BAY_EDITOR_CMD:-vi}}}
  # shellcheck disable=SC2086
  $ed "$f" || true
  [ -s "$f" ] || rm -f "$f"
  return 0
}

# The hub's C-o. Nothing on the rule; a die() holds its message on screen.
cmd_note_prompt() {
  [ -n "${1:-}" ] || return 0
  ( cmd_note "$1" ) || pause
}

cmd_hub() {
  command -v fzf >/dev/null || die "fzf is required for the hub"
  local self=$BAY_SELF picked here="" nudge=""
  # Inside tmux the first two rows are you and the rule under you, so the
  # cursor starts on row three: the session you were in before this one.
  # --sync makes pos() wait for the rows to be in; they take ~50ms.
  here_session; here=$REPLY
  # The rows fzf reloads are a fresh process each time; hand them the answer.
  [ -n "$here" ] && export BAY_HERE=$here && nudge="pos(3)+"
  # shellcheck disable=SC2086
  picked=$(cmd_rows | fzf \
    --sync \
    --delimiter="$TAB" \
    --with-nth=2 \
    --ansi \
    --no-sort \
    --layout=reverse \
    --prompt='bay> ' \
    --header="$(cmd_header)" \
    --listen \
    --preview-window=right,45%,border-left \
    --bind="focus:preview($self --preview {1})" \
    --bind="start:${nudge}execute-silent($self --tick \$FZF_PORT & $self --refresh &)" \
    --bind='ctrl-n:down,ctrl-p:up' \
    --bind="ctrl-r:reload-sync($self --rows)" \
    --bind="ctrl-t:execute($self --new)" \
    --bind="ctrl-e:execute($self --rename {1})+reload-sync($self --rows)" \
    --bind="ctrl-o:execute($self --note {1})+preview($self --preview {1})" \
    --bind="ctrl-x:execute-silent($self kill {1})+reload-sync($self --rows)" \
    --bind="ctrl-d:execute($self --done {1})+reload-sync($self --rows)") || return 0

  [ -n "$picked" ] || return 0
  local name
  name=$(printf '%s' "$picked" | cut -f1)
  [ -n "$name" ] || return 0
  # Enter on your own row: nowhere to go, so just close.
  [ "$name" = "$here" ] && return 0

  # A session that is not a workspace or repo: just switch to it.
  if has_session "$name" && [ ! -d "$WS_ROOT/$name" ] && ! root_for "$name" >/dev/null 2>&1; then
    focus "$name"
    return 0
  fi
  cmd_open "$name"
}

case "${1:-hub}" in
  hub) cmd_hub ;;
  open) shift; cmd_open "$@" ;;
  kill) shift; cmd_kill "$@" ;;
  rename | mv) shift; cmd_rename "$@" ;;
  note) shift; cmd_note "$@" ;;
  --rows) shift; cmd_rows "$@" ;;   # internal, used by fzf
  --header) cmd_header ;;           # internal
  --tick) shift; cmd_tick "$@" ;;   # internal, drives the spinner
  --refresh) cmd_refresh ;;         # internal, fills the preview caches
  --preview) shift; cmd_preview "$@" ;;
  --new) cmd_new_prompt ;;
  --root) shift; root_for "${1:-}" ;; # internal, for the pane command cmd_new starts
  --rename) shift; cmd_rename_prompt "$@" ;;
  --note) shift; cmd_note_prompt "$@" ;;
  --done) shift; cmd_done_prompt "$@" ;;
  --done-job) shift; cmd_done_job "$@" ;; # internal, the detached half of C-d
  # The comment block at the top, however long it grows.
  help | -h | --help) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0" ;;
  *) die "unknown command: $1 (try: bay help)" ;;
esac
