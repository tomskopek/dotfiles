#!/usr/bin/env bash
# ws — multi-repo feature workspaces built on git worktrees.
#
# A workspace is a directory under ~/ws containing one worktree per repo the
# feature touches, each seeded on branch <prefix><workspace>. The seed is just
# a starting point — switch/stack branches inside a worktree freely; the
# workspace names the feature, not a branch. One workspace per stack; a branch
# can only be checked out in one worktree at a time (keep canonical clones
# parked on main).
#
#   ws new <name> [repo...]   create workspace (fzf multi-select repos if omitted)
#   ws add [repo...]          add repos to the workspace you're currently inside
#   ws done [name] [--force]  remove worktrees + workspace dir (branches survive)
#   ws list|ls                workspaces, their repos, branches, dirty state
#
# Machine-specific settings (repo names, local config to copy) live in
# ~/.config/ws/config.sh — see ws.config.example.sh. Nothing here is
# organization-specific; keep it that way and put such details in the config.
set -euo pipefail

# --- defaults (override in ~/.config/ws/config.sh) ---------------------------
WS_ROOT="${WS_ROOT:-$HOME/ws}"
DEV_ROOT="${DEV_ROOT:-$HOME/dev}"
# Prefix for the branch a new worktree is seeded on, e.g. "jane/".
WS_BRANCH_PREFIX="${WS_BRANCH_PREFIX:-}"
# Repos never offered in the picker (duplicate clones, dotfiles, ...).
WS_EXCLUDE_REPOS="${WS_EXCLUDE_REPOS:-}"
# Repos listed first in the picker.
WS_PINNED_REPOS="${WS_PINNED_REPOS:-}"
# Untracked paths copied into every new worktree from its canonical clone.
WS_COMMON_COPY="${WS_COMMON_COPY:-.env}"

WS_CONFIG="${WS_CONFIG:-$HOME/.config/ws/config.sh}"
# shellcheck disable=SC1090
[ -f "$WS_CONFIG" ] && . "$WS_CONFIG"

log() { printf '\033[1;35m[ws]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[ws]\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31m[ws]\033[0m %s\n' "$*" >&2; exit 1; }

# Canonical clone path for a repo name. Config may override ws_repo_path().
repo_path() {
  if declare -f ws_repo_path >/dev/null; then
    ws_repo_path "$1"
  else
    echo "$DEV_ROOT/$1"
  fi
}

# Untracked files/dirs to copy into a fresh worktree: the common list plus
# whatever the config's optional ws_copy_list() adds for this repo.
copy_list() {
  echo "$WS_COMMON_COPY $(declare -f ws_copy_list >/dev/null && ws_copy_list "$1" || true)"
}

# Resolve the repo's main branch ref.
main_ref() {
  local src=$1 ref
  for ref in origin/main origin/master main master; do
    if git -C "$src" rev-parse --verify --quiet "$ref" >/dev/null; then
      echo "$ref"
      return 0
    fi
  done
  return 1
}

# The canonical clone a worktree belongs to, straight from git — independent of
# naming, so teardown survives renamed/moved canonical clones.
canonical_of() {
  local wt=$1 common
  common=$(git -C "$wt" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  dirname "$common"
}

# The workspace name for the directory we're standing in, if any.
current_ws() {
  case "$PWD/" in
    "$WS_ROOT"/*) local rest="${PWD#"$WS_ROOT"/}" && echo "${rest%%/*}" ;;
    *) return 1 ;;
  esac
}

# Add one repo's worktree to a workspace: branch, copy untracked, run setup.
add_repo() {
  local ws=$1 repo=$2
  local src dest branch base
  src=$(repo_path "$repo")
  dest="$WS_ROOT/$ws/$repo"
  branch="${WS_BRANCH_PREFIX}${ws}"

  [ -d "$src/.git" ] || [ -f "$src/.git" ] || die "no repo at $src"
  [ -e "$dest" ] && die "$dest already exists"

  git -C "$src" fetch origin 2>/dev/null || warn "$repo: fetch failed, using local refs"

  if git -C "$src" show-ref --verify --quiet "refs/heads/$branch"; then
    log "$repo: adding worktree on existing branch $branch"
    git -C "$src" worktree add "$dest" "$branch"
  else
    base=$(main_ref "$src") || die "$repo: no main/master branch found"
    log "$repo: adding worktree, new branch $branch (from $base)"
    git -C "$src" worktree add -b "$branch" "$dest" "$base"
  fi

  # Untracked local config doesn't come along with a worktree — copy it over.
  local item
  for item in $(copy_list "$repo"); do
    if [ -e "$src/$item" ] && [ ! -e "$dest/$item" ]; then
      mkdir -p "$dest/$(dirname "$item")"
      cp -R "$src/$item" "$dest/$item"
      log "$repo: copied $item"
    fi
  done

  # Setup hooks, auto-detected from lockfiles. Failures warn but don't abort.
  if [ -f "$dest/pnpm-lock.yaml" ]; then
    log "$repo: pnpm install..."
    (cd "$dest" && pnpm install) || warn "$repo: pnpm install failed — run it manually"
  elif [ -f "$dest/package-lock.json" ]; then
    log "$repo: npm install..."
    (cd "$dest" && npm install) || warn "$repo: npm install failed — run it manually"
  elif [ -f "$dest/yarn.lock" ]; then
    log "$repo: yarn install..."
    (cd "$dest" && yarn install) || warn "$repo: yarn install failed — run it manually"
  fi
  if [ -f "$dest/uv.lock" ]; then
    log "$repo: uv sync..."
    (cd "$dest" && uv sync) || warn "$repo: uv sync failed — run it manually"
  fi

  # Anything else this repo needs (codegen, submodules, ...).
  if declare -f ws_setup >/dev/null; then
    ws_setup "$repo" "$dest" || warn "$repo: ws_setup failed"
  fi
}

# Candidate repo names for fzf: pinned first, then other git dirs in DEV_ROOT.
candidate_repos() {
  local name d
  for name in $WS_PINNED_REPOS; do
    echo "$name"
  done
  for d in "$DEV_ROOT"/*/; do
    name=$(basename "$d")
    [ -e "$d/.git" ] || continue
    case " $WS_EXCLUDE_REPOS $WS_PINNED_REPOS " in *" $name "*) continue ;; esac
    echo "$name"
  done
}

cmd_new() {
  local ws=${1:-} && shift || true
  [ -n "$ws" ] || die "usage: ws new <name> [repo...]"
  [ -d "$WS_ROOT/$ws" ] && die "workspace $ws already exists ($WS_ROOT/$ws)"

  local repos=("$@")
  if [ ${#repos[@]} -eq 0 ]; then
    command -v fzf >/dev/null || die "no repos given and fzf not found"
    local picked
    picked=$(candidate_repos | fzf --multi --prompt="repos for $ws (tab to multi-select)> ") || die "no repos selected"
    # shellcheck disable=SC2206
    repos=($picked)
  fi

  mkdir -p "$WS_ROOT/$ws"
  local repo
  for repo in "${repos[@]}"; do
    add_repo "$ws" "$repo"
  done
  log "workspace ready: $WS_ROOT/$ws (${repos[*]})"
}

cmd_add() {
  local ws
  ws=$(current_ws) || die "not inside a workspace ($WS_ROOT/...)"
  local repos=("$@")
  if [ ${#repos[@]} -eq 0 ]; then
    command -v fzf >/dev/null || die "usage: ws add <repo...> (no fzf found for interactive pick)"
    local picked
    picked=$(candidate_repos | grep -vFx -f <(ls "$WS_ROOT/$ws") \
      | fzf --multi --prompt="add repos to $ws (tab to multi-select)> ") || die "no repos selected"
    # shellcheck disable=SC2206
    repos=($picked)
  fi
  local repo
  for repo in "${repos[@]}"; do
    add_repo "$ws" "$repo"
  done
}

cmd_done() {
  local ws="" force=0 arg
  for arg in "$@"; do
    case "$arg" in
      --force) force=1 ;;
      *) ws=$arg ;;
    esac
  done
  [ -n "$ws" ] || ws=$(current_ws) || die "usage: ws done <name> (or run from inside one)"
  local dir="$WS_ROOT/$ws"
  [ -d "$dir" ] || die "no workspace $ws"

  # Refuse to destroy uncommitted work — including inside submodules, since
  # removal below force-removes them.
  local wt
  for wt in "$dir"/*/; do
    [ -e "$wt/.git" ] || continue
    local dirt
    dirt=$(git -C "$wt" status --porcelain)
    if [ -f "$wt/.gitmodules" ]; then
      dirt="$dirt$(git -C "$wt" submodule foreach --recursive --quiet 'git status --porcelain' 2>/dev/null || true)"
    fi
    if [ -n "$dirt" ] && [ "$force" -eq 0 ]; then
      die "$(basename "$wt") has uncommitted changes — commit/stash them, or ws done --force"
    fi
  done

  local force_flag=""
  [ "$force" -eq 1 ] && force_flag="--force"
  for wt in "$dir"/*/; do
    [ -e "$wt/.git" ] || continue
    local repo branch canonical
    repo=$(basename "$wt")
    branch=$(git -C "$wt" branch --show-current)
    canonical=$(canonical_of "$wt") || canonical=$(repo_path "$repo")
    log "removing worktree $repo (branch $branch survives in $canonical)"
    # Plain remove refuses on worktrees containing submodules ("working trees
    # containing submodules cannot be moved or removed") — --force handles
    # those. Work is already verified committed above, so forcing is safe.
    if ! git -C "$canonical" worktree remove $force_flag "$wt" 2>/dev/null; then
      if ! git -C "$canonical" worktree remove --force "$wt" 2>/dev/null; then
        rm -rf "$wt"
        git -C "$canonical" worktree prune
        log "$repo: removed by hand + pruned"
      fi
    fi
  done

  rm -rf "$dir"
  # Step 2 will manage tmux sessions; harmless if none exists yet.
  if command -v tmux >/dev/null; then
    tmux kill-session -t "=$ws" 2>/dev/null || true
  fi
  log "workspace $ws removed"
}

cmd_list() {
  [ -d "$WS_ROOT" ] || { log "no workspaces yet ($WS_ROOT is empty)"; return; }
  local dir wt dirty
  for dir in "$WS_ROOT"/*/; do
    [ -d "$dir" ] || continue
    printf '\033[1m%s\033[0m\n' "$(basename "$dir")"
    for wt in "$dir"/*/; do
      [ -e "$wt/.git" ] || continue
      dirty=""
      [ -n "$(git -C "$wt" status --porcelain)" ] && dirty=" \033[33m*dirty\033[0m"
      printf "  %-14s %s$dirty\n" "$(basename "$wt")" "$(git -C "$wt" branch --show-current)"
    done
  done
}

case "${1:-help}" in
  new) shift; cmd_new "$@" ;;
  add) shift; cmd_add "$@" ;;
  done) shift; cmd_done "$@" ;;
  list | ls) shift; cmd_list "$@" ;;
  help | -h | --help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command: $1 (try: ws help)" ;;
esac
